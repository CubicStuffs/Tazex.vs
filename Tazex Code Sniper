local AI_CACHE = {}
local AI_CACHE_TTL = 300  -- 5 minutes
local AI_CACHE_MAX = 50

local function aiCacheKey(text)
    return tostring(text):lower():gsub("%s+", " "):gsub("[^%w ]", ""):match("^%s*(.-)%s*$") or ""
end
local function aiCacheGet(text)
    local k = aiCacheKey(text)
    local e = AI_CACHE[k]
    if not e then return nil end
    if os.clock() - e.t > AI_CACHE_TTL then AI_CACHE[k] = nil; return nil end
    return e.a
end
local function aiCacheSet(text, answer)
    local k = aiCacheKey(text)
    if k == "" then return end
    AI_CACHE[k] = { a = answer, t = os.clock() }
    -- prune if too big
    local count = 0
    for _ in pairs(AI_CACHE) do count = count + 1 end
    if count > AI_CACHE_MAX then
        local oldestK, oldestT = nil, math.huge
        for kk, vv in pairs(AI_CACHE) do
            if vv.t < oldestT then oldestT = vv.t; oldestK = kk end
        end
        if oldestK then AI_CACHE[oldestK] = nil end
    end
end

