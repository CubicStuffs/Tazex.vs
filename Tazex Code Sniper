local Util = {}
do
    function Util.stripRich(s) if type(s) ~= "string" then return tostring(s) end return (s:gsub("<[^>]->", "")) end
    function Util.trim(s) return (s or ""):gsub("^%s+", ""):gsub("%s+$", "") end
    function Util.tokenize(text)
        local t = {}
        for w in text:gmatch("[%w_]+") do if w:lower() ~= "and" then t[#t + 1] = w end end
        return t
    end
    function Util.normKey(text)
        local t = tostring(text or ""):lower()
        t = t:gsub("<[^>]->", ""):gsub("%s+", " ")
        return t:match("^%s*(.-)%s*$") or ""
    end
    -- ⭐ FIX: robust cue-prefix stripping (CASE-INSENSITIVE)
    -- handles "Use code...", "USE CODE!!", "Code is..", etc.
    function Util.stripCuePrefix(text)
        if not text or text == "" then return text end
        local lowerText = text:lower()
        local patterns = {
            "^%s*the%s+riddle%s+is[%s%p]*",
            "^%s*riddle%s+is[%s%p]*",
            "^%s*the%s+code%s+is[%s%p]*",
            "^%s*code%s+is[%s%p]*",
            "^%s*use%s+this%s+code[%s%p]*",
            "^%s*use%s+code[%s%p]*",
            "^%s*question%s+is[%s%p]*",
        }
        for _, pat in ipairs(patterns) do
            local stripped, n = lowerText:gsub(pat, "")
            if n > 0 then
                local prefixLen = #lowerText - #stripped
                if prefixLen > 0 and prefixLen <= #text then
                    local orig = text:sub(prefixLen + 1)
                    orig = orig:gsub("^[%s%p]+", ""):gsub("[%s%p]+$", "")
                    if orig ~= "" then return orig end
                end
            end
        end
        return text
    end
end

local SOLD_OUT_MARKERS = {"sold out","out of stock","no longer available","already redeemed","already used","code expired","code has expired","this code is expired","redeem limit","limit reached","max redeems","not available","code unavailable","unavailable","code no longer","no longer valid","not valid anymore","invalid code","code is invalid","code invalid","code not valid","code used","already sold"}
local function isSoldOutOrInvalid(text)
    local l = tostring(text or ""):lower()
    for _, m in ipairs(SOLD_OUT_MARKERS) do if l:find(m, 1, true) then return true end end
    return false
end

