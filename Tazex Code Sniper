-- ⭐ SAB times use Sammy's timezone: US Eastern (ET) with auto-DST
-- EST = UTC-5 (winter), EDT = UTC-4 (summer)
-- Day boundary = 5:00 PM ET (Sammy's reset hour)
local function getEasternOffset()
    -- US Eastern DST: starts 2nd Sunday of March, ends 1st Sunday of November
    local nowUtc = os.time()
    local y = tonumber(os.date("!%Y", nowUtc))
    local function nthSunday(year, month, n)
        local first = os.time({ year = year, month = month, day = 1, hour = 0, min = 0, sec = 0, isdst = false })
        local wday = tonumber(os.date("!%w", first)) -- 0=Sun..6=Sat
        local firstSunday = 1 + ((7 - wday) % 7)
        return firstSunday + (n - 1) * 7
    end
    local dstStartDay = nthSunday(y, 3, 2)  -- 2nd Sunday of March
    local dstEndDay   = nthSunday(y, 11, 1) -- 1st Sunday of November
    local dstStartTs = os.time({ year = y, month = 3, day = dstStartDay, hour = 7, min = 0, sec = 0, isdst = false }) -- 2AM EST = 7AM UTC
    local dstEndTs   = os.time({ year = y, month = 11, day = dstEndDay, hour = 6, min = 0, sec = 0, isdst = false })  -- 2AM EDT = 6AM UTC
    if nowUtc >= dstStartTs and nowUtc < dstEndTs then
        return -4 * 3600 -- EDT
    end
    return -5 * 3600 -- EST
end
