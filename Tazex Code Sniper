    -- ⭐ NEW: broader check for riddle-like text (word-by-word KB check)
    function Riddle.isRiddleLike(text)
        if not text or text == "" then return false end
        if Riddle.isActual(text) then return true end
        local ws = {}
        for w in text:gmatch("%S+") do table.insert(ws, w) end
        if #ws < 2 or #ws > 8 then return false end
        local realWords = 0
        -- ⭐ PERF: single whole-text KB match first (cache-fast now)
        do
            local kbA, _, kbP = findFirstMatch(text)
            if kbA and kbP then
                local pw = 0
                for _ in kbP:gmatch("%S+") do pw = pw + 1 end
                if pw >= 2 then return true end
                -- ⭐ PERF: single-word KB match → definitely a riddle, skip per-word scan
                if pw == 1 and #ws <= 3 then return true end
            end
        end
        for _, w in ipairs(ws) do
            local cw = w:gsub("[^%w]","")
            if cw ~= "" and not cw:match("^%d+$") then
                local lower = cw:lower()
                if not FILL[lower] and #lower > 1 then
                    realWords = realWords + 1
                    if not (findFirstMatch(cw) or findByName(cw)) then return false end
                end
            end
        end
        return realWords >= 2
