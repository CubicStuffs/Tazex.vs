-- ⭐ Decode HTML entities (fixes "&apos;" breaking riddles like TODAY'S DAY)
local function decodeHtmlEntities(text)
    if not text then return text end
    text = text:gsub("&apos;", "'"):gsub("&#39;", "'")
    text = text:gsub("&quot;", '"'):gsub("&#34;", '"')
    text = text:gsub("&amp;", "&"):gsub("&#38;", "&")
    text = text:gsub("&lt;", "<"):gsub("&gt;", ">")
    text = text:gsub("&nbsp;", " ")
    text = text:gsub("&#(%d+);", function(n)
        local c = tonumber(n); return c and string.char(c) or ""
    end)
    text = text:gsub("&[%w#]+;", "")
    return text
end

local function handleRiddle(rawText)
    if isSoldOutOrInvalid(rawText) then return end
    rawText = decodeHtmlEntities(rawText)
    UI.qText.Text = rawText
    UI.qText.TextColor3 = C.txt
    if not riddleSolverEnabled then
        UI.aText.Text = "Riddler is OFF"; UI.aText.TextColor3 = C.dim; return
    end
    if not Riddle.isRiddleLike(rawText) then return end
    UI.addConsoleLine("Riddle: "..rawText, "riddle")
    UI.aText.Text = "solving…"; UI.aText.TextColor3 = C.yellow

    -- ⭐ FAST-PATH: KB se pehle solve karo (0 tokens, instant)
    local kbFast = Riddle.solve(rawText)
    if kbFast and #kbFast > 0 then
        -- Only trust strong KB matches (>= 100 score OR multi-part)
        local _, _, _, kbScore = Riddle.findFirstMatch(rawText)
        local isMultiPart = rawText:find(" and ", 1, true) or rawText:find(" plus ", 1, true)
        -- Agar multi-part hai, toh sirf tabhi accept karo jab score 100+ ho (yani pura match ho)
        if (isMultiPart and kbScore and kbScore >= 100) or (not isMultiPart and kbScore and kbScore >= 100) then
            UI.addConsoleLine("⚡ KB fast: " .. kbFast, "success")
            UI.aText.Text = kbFast; UI.aText.TextColor3 = C.green
            task.spawn(flashAnswerBox, C.green)
            local secureList = getSecureList(kbFast)
            if UI.addToFeed then
                UI.addToFeed(rawText, kbFast, os.date("%H:%M:%S"), "0.00s", secureList)
                if openFeedOnHitEnabled and not UI.feedPopup.Visible then AnimH.popWindow(UI.feedPopup) end
            end
            lastRiddleText = rawText
            lastRiddleAnswer = kbFast
            queueSecureRedeem(kbFast)

            -- ⭐ Update Status Pill Directly
            if #secureList > 1 and UI.statusLbl then
                UI.statusDot.BackgroundColor3 = C.yellow
                UI.statusLbl.Text = "secure: tried all " .. #secureList .. " - " .. table.concat(secureList, ", ") .. ",..."
                UI.statusLbl.TextColor3 = C.yellow
                task.delay(8, function() if UI.updateAPIStatus then UI.updateAPIStatus(false, false) end end)
            end
            return
        end
    end

    -- ⭐ AI-PRIMARY PATH (using ChatContext)
    local solveStartTime = os.clock()
    local solveTimeStr = os.date("%H:%M:%S")
    local contextStr = table.concat(ChatContext, "\n")
    task.spawn(function()
        local aiAnswer, aiErr = AISolver.solve(rawText, contextStr)
        local finalAnswer = aiAnswer
        if finalAnswer and type(finalAnswer) == "string" then
            finalAnswer = finalAnswer:upper():gsub("%s+", ""):gsub("[^%w]", "")
        end

        -- (Offline fallback removed)
        local overrideAns, overrideNote = checkOverride(rawText, finalAnswer)
        if overrideAns ~= finalAnswer then
            UI.addConsoleLine("⚡ Override: "..tostring(overrideNote), "warn")
            finalAnswer = overrideAns
        end
        if finalAnswer and #finalAnswer > 0 then
            local solveEndTime = os.clock()
            local durationStr = string.format("%.2fs", solveEndTime - solveStartTime)
            local secureList = getSecureList(finalAnswer)
            if UI.addToFeed then
                UI.addToFeed(rawText, finalAnswer, solveTimeStr, durationStr, secureList)
                if openFeedOnHitEnabled and not UI.feedPopup.Visible then AnimH.popWindow(UI.feedPopup) end
            end
            lastRiddleText = rawText
            lastRiddleAnswer = finalAnswer
            UI.aText.Text = finalAnswer; UI.aText.TextColor3 = C.green
            task.spawn(flashAnswerBox, C.green)
            AnimH.popIn(UI.aBox)
            UI.addConsoleLine("🤖 "..finalAnswer.." ("..(aiAnswer and "AI" or "offline").." | "..durationStr..")", "success")
            queueSecureRedeem(finalAnswer)

            -- ⭐ Update Status Pill Directly
            if #secureList > 1 and UI.statusLbl then
                UI.statusDot.BackgroundColor3 = C.yellow
                UI.statusLbl.Text = "secure: tried all " .. #secureList .. " - " .. table.concat(secureList, ", ") .. ",..."
                UI.statusLbl.TextColor3 = C.yellow
                task.delay(8, function() if UI.updateAPIStatus then UI.updateAPIStatus(false, false) end end)
            end
        else
            UI.aText.Text = "No answer"; UI.aText.TextColor3 = C.red
            task.spawn(flashAnswerBox, C.red)
            UI.addConsoleLine("AI failed: "..tostring(aiErr), "warn")
        end
    end)
    do return end

    -- ⭐ Full multi-part solve (DEAD CODE — kept for reference, unreachable)
    local fullSolve = Riddle.solve(rawText)
    local memAns = MemoryBank.answer(rawText)
    local kbAns, _, kbPat, kbScore = nil, nil, nil, nil
    if (not fullSolve or #fullSolve == 0) and Riddle.findFirstMatch then
        kbAns, _, kbPat, kbScore = Riddle.findFirstMatch(rawText)
    end
    local kbWords = 0
    if kbPat then for _ in kbPat:gmatch("%S+") do kbWords = kbWords + 1 end end

    -- ⭐ FIX: detect multi-part questions (comma / "and" / "plus")
    local hasMultiPart = rawText:find(",") ~= nil or rawText:find(" and ") ~= nil or rawText:find(" plus ") ~= nil

    local answer, source
    -- ⭐ FIX: for multi-part questions, MemoryBank wins (it splits correctly + uses KB per piece)
    if hasMultiPart and memAns and #memAns > 0 then
        answer, source = memAns, "memory"
    elseif fullSolve and #fullSolve > 0 then
        answer, source = fullSolve, "knowledge"
    elseif memAns and #memAns > 0 then
        answer, source = memAns, "memory"
    elseif kbAns and kbScore and kbScore >= 100 and kbWords >= 2 then
        answer, source = kbAns, "knowledge"
    elseif kbAns and #kbAns > 0 then
        answer, source = kbAns, "knowledge"
    end

    -- ⭐ Fallback: if full solve failed, try the BASE (before last "and")
    if not answer then
        local baseOnly = rawText:match("^(.-)%s+and%s+")
        if baseOnly then
            local b = Riddle.solve(baseOnly)
                or (Riddle.findFirstMatch and Riddle.findFirstMatch(baseOnly))
                or MemoryBank.answer(baseOnly)
            if b and #b > 0 then answer = b; source = "knowledge" end
        end
    end

    -- ⭐ Suffix append: only when tail is a SINGLE word/number
    --   "rarest brainrot and 67"     → POLAROIDINI + 67     = POLAROIDINI67
    --   "rarest brainrot and summer" → POLAROIDINI + SUMMER = POLAROIDINISUMMER
    if answer then
        local baseText, suffixText = rawText:match("^(.-)%s+and%s+(.+)$")
        if baseText and suffixText then
            local s = suffixText:gsub("^%s+",""):gsub("%s+$","")
            local wc = 0
            for _ in s:gmatch("%S+") do wc = wc + 1 end
            if wc == 1 then
                local numOnly = s:match("^(%d+)$")
                local append
                if numOnly then append = numOnly
                else
                    local sAns = (Riddle.findFirstMatch and Riddle.findFirstMatch(s)) or Riddle.findByName(s)
                    if sAns and #sAns > 0 then append = sAns
                    else append = s:gsub("[^%w]",""):upper() end
                end
                if append and #append > 0 and not answer:find(append, 1, true) then
                    answer = answer .. append
                end
            end
        end
    end

    if answer and #answer > 0 then
        lastRiddleText = rawText
        lastRiddleAnswer = answer
        UI.aText.Text = answer; UI.aText.TextColor3 = C.green
