local Riddle = {}
do
    local FILL = {what=true,is=true,the=true,a=true,an=true,["do"]=true,does=true,did=true,you=true,are=true,was=true,were=true,am=true,i=true,my=true,me=true,we=true,our=true,of=true,to=true,["in"]=true,on=true,at=true,["and"]=true,["or"]=true,have=true,has=true,it=true,["for"]=true,how=true,where=true,who=true,when=true,which=true,can=true,s=true,will=true,would=true,could=true,please=true,this=true,that=true,these=true,those=true}
    local function normalizeRiddleText(t)
        t = tostring(t or ""):lower()
        t = t:gsub("what's","what is"):gsub("whats","what is")
        t = t:gsub("who's","who is"):gsub("whos","who is")
        t = t:gsub("favourite","favorite"):gsub("colour","color")
        t = t:gsub("1st","first"):gsub("2nd","second"):gsub("3rd","third"):gsub("4th","fourth")
        t = t:gsub("5th","fifth"):gsub("6th","sixth"):gsub("7th","seventh"):gsub("8th","eighth")
        t = t:gsub("[^%w%s]"," "):gsub("%s+"," ")
        return t:match("^%s*(.-)%s*$") or ""
    end
    local function stemRiddleWord(w)
        w = tostring(w or ""):lower()
        if #w>4 and w:sub(-3)=="ing" then w=w:sub(1,-4) end
        if #w>4 and w:sub(-2)=="ed" then w=w:sub(1,-3) end
        if #w>4 and w:sub(-2)=="es" then w=w:sub(1,-3) end
        if #w>3 and w:sub(-1)=="s" then w=w:sub(1,-2) end
        local al={original="og",earliest="first",newest="latest",recent="latest",last="latest",final="latest",made="add",added="add",created="add",born="birth",birthday="birth",called="name",release="releas",released="releas"}
        return al[w] or w
    end
    local function riddleWords(t)
        local w={}
        for word in normalizeRiddleText(t):gmatch("%w+") do
            local s=stemRiddleWord(word)
            if s~="" and not FILL[s] and not s:match("^%d+$") then w[s]=true end
        end
        if w.brainrot and w.god then w.brainrotgod=true end
        if w.brainrotgod then w.brainrot=true; w.god=true end
        return w
    end
    local function riddleMatch(msg, pat)
        local ph=normalizeRiddleText(pat)
        if msg:find(ph,1,true) then return true end
        if msg:gsub("%s+",""):find(ph:gsub("%s+",""),1,true) then return true end
        if pat:find("%d") then return false end
        local ww,rr=riddleWords(pat),riddleWords(msg)
        local n=0
        for w in pairs(ww) do n=n+1; if not rr[w] then return false end end
        if n==1 then for w in pairs(rr) do if not ww[w] then return false end end end
        if n <= 3 then
            local mcount = 0
            for _ in pairs(rr) do mcount = mcount + 1 end
            if mcount > n then return false end
        end
        return n>0
    end
    -- ⭐ PERF: precompute KB once at load — makes every riddle solve ~50x faster
    local KB_CACHE, KB_ANSWER_MAP = {}, {}
    do
        for _, e in ipairs(BRAINROT_KNOWLEDGE) do
            local ansClean = tostring(e.a):gsub("%s+",""):upper()
            KB_ANSWER_MAP[ansClean] = e.a
            for _, pt in ipairs(e.p) do
                local normPat = normalizeRiddleText(pt)
                local words = riddleWords(pt)
                local wc = 0
                for _ in pairs(words) do wc = wc + 1 end
                KB_CACHE[#KB_CACHE+1] = {
                    norm = normPat,
                    normNoSpace = normPat:gsub("%s+",""),
                    words = words,
                    wordCount = wc,
                    hasDigit = pt:find("%d") ~= nil,
                    answer = ansClean,
                    originalAnswer = e.a,
                    pattern = pt,
                }
            end
        end
    end

    local function riddleMatchCached(msgNorm, msgNoSpace, msgWords, msgCount, c)
        if msgNorm:find(c.norm, 1, true) then return true end
        if msgNoSpace:find(c.normNoSpace, 1, true) then return true end
        if c.hasDigit then return false end
        local n = 0
        for w in pairs(c.words) do
            n = n + 1
            if not msgWords[w] then return false end
        end
        if n == 1 then
            for w in pairs(msgWords) do if not c.words[w] then return false end end
        end
        if n <= 3 and msgCount > n then return false end
        return n > 0
    end

    local function findFirstMatch(txt)
        local normalized = normalizeRiddleText(txt)
        local normalizedNoSpace = normalized:gsub("%s+","")
        local msgWords = riddleWords(normalized)
        local msgCount = 0
        for _ in pairs(msgWords) do msgCount = msgCount + 1 end
        local bestEntry, bestScore, bestPattern = nil, -1, nil
        for _, c in ipairs(KB_CACHE) do
            if riddleMatchCached(normalized, normalizedNoSpace, msgWords, msgCount, c) then
                local score = c.wordCount
                if score == msgCount then score = score + 100 end
                if score > bestScore then
                    bestScore = score
                    bestEntry = c
                    bestPattern = c.pattern
                end
            end
        end
        if bestEntry then return bestEntry.answer, bestEntry.originalAnswer, bestPattern, bestScore end
        return nil, nil, nil, nil
    end

    local function findByName(word)
        if not word or word == "" then return nil end
        local up = tostring(word):gsub("[^%w]",""):upper()
        if up == "" or #up < 2 then return nil end
        local found = KB_ANSWER_MAP[up]
        if found then return tostring(found):gsub("%s+",""):upper() end
        return nil
    end
    Riddle.findByName = findByName
    function Riddle.solve(message)
        if not message or message=="" then return nil end
        local working = tostring(message):lower()
        working = working:gsub("what's","what is"):gsub("whats","what is")
        working = working:gsub("who's","who is"):gsub("whos","who is")
        working = working:gsub("favourite","favorite"):gsub("colour","color")
        working = working:gsub("&"," and "):gsub(","," and ")
        working = working:gsub("%s+plus%s+", " and "):gsub("%s+also%s+", " and ")
        working = working:gsub("%s+"," ")
        local pieces = {}
        local andPieces, cur = {}, {}
        for word in working:gmatch("%S+") do
            if word == "and" then
                if #cur > 0 then table.insert(andPieces, table.concat(cur, " ")); cur = {} end
            else table.insert(cur, word) end
        end
        if #cur > 0 then table.insert(andPieces, table.concat(cur, " ")) end
        for _, piece in ipairs(andPieces) do
            local p = piece:match("^%s*(.-)%s*$") or ""
            if p ~= "" then
                local subparts, buf = {}, {}
                for word in p:gmatch("%S+") do
                    if word == "my" and #buf > 1 then table.insert(subparts, table.concat(buf, " ")); buf = { word }
                    else table.insert(buf, word) end
                end
                if #buf > 0 then table.insert(subparts, table.concat(buf, " ")) end
                for _, sp in ipairs(subparts) do
                    sp = sp:match("^%s*(.-)%s*$") or ""
                    if sp ~= "" then
                        -- ⭐ skip filler-only pieces (e.g. "what is") that break multi-part lookups
                        local hasContent = false
                        for w in sp:gmatch("%S+") do
                            if not FILL[w:lower()] then hasContent = true; break end
                        end
                        if hasContent then table.insert(pieces, sp) end
                    end
                end
            end
        end
        if #pieces <= 1 then
            local baseAnswer, originalAnswer, matchedPat, baseScore = findFirstMatch(message)
            -- ⭐ FIX: word-by-word only overrides WEAK base matches
            -- Prevents "sammy zodiac" → SAMMYPISCES (should stay PISCES)
            local ws = {}
            for w in message:gmatch("%S+") do table.insert(ws, w) end
            if #ws >= 2 and #ws <= 12 then
                local wsparts = {}
                local allW = true
                for _, w in ipairs(ws) do
                    local clean_w = w:gsub("[^%w]","")
                    if clean_w == "" then
                        -- skip pure punctuation
                    elseif clean_w:match("^%d+$") then
                        table.insert(wsparts, clean_w)
                    else
                        local a = findFirstMatch(clean_w) or findByName(clean_w)
                        if not a then allW = false; break end
                        table.insert(wsparts, a)
                    end
                end
                if allW and #wsparts > 1 then
                    local combined = table.concat(wsparts)
                    if not baseAnswer then return combined end
                    -- Only override if base came from a weak/partial match
                    if (baseScore or 0) < 100 and #combined > #baseAnswer then
                        return combined
                    end
                end
            end
            if not baseAnswer then return nil end
            local numsInAnswer = {}
            local local_hadDigit = false
            for num in tostring(originalAnswer):gmatch("%d+") do numsInAnswer[num] = true; local_hadDigit = true end
            if local_hadDigit then return baseAnswer end
            if matchedPat and matchedPat:find("%d") then return baseAnswer end
            local suffix
            for num in tostring(message):gmatch("%d+") do if not numsInAnswer[num] then suffix = num end end
            if suffix and #suffix > 0 then return baseAnswer..suffix end
            return baseAnswer
        end
        local answerParts = {}
        local allOk = true
        for _, piece in ipairs(pieces) do
            piece = piece:match("^%s*(.-)%s*$")
            if piece ~= "" then
                local numOnly = piece:match("^(%d+)$")
                if numOnly then table.insert(answerParts, numOnly)
                else
                    local a = findFirstMatch(piece) or findByName(piece)
                    if not a then allOk = false; break end
                    table.insert(answerParts, a)
                end
            end
        end
        if allOk and #answerParts > 0 then return table.concat(answerParts) end
        -- ⭐ FIX: Agar question multi-part hai aur KB mein answer nahi mila, toh AI ko try karne do
        if #pieces > 1 then return nil end
        local fallback = findFirstMatch(message)
        if fallback then return fallback end
        return nil
    end
