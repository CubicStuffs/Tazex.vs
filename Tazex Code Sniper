-- ⭐ NEW: Secure Answer Generator
local function getSecureList(baseCode)
    if not secureAnswerEnabled then return {baseCode} end
    local list = {baseCode}
    local plural = baseCode .. "S"
    if baseCode:sub(-1) == "S" then plural = baseCode:sub(1, -2) end
    table.insert(list, plural)
    return list
end

queueSecureRedeem = function(baseCode)
    local list = getSecureList(baseCode)
    
    -- ⭐ Show in Console
    if #list > 1 and UI and UI.addConsoleLine then
        local codesStr = table.concat(list, ", ")
        UI.addConsoleLine("secure: tried all " .. #list .. " - " .. codesStr .. ",...", "warn")
    end

    for _, code in ipairs(list) do
        queueRedeem(code)
    end
    return list
end

queueRedeem = function(code)
    code = Util.trim(code)
    if code == "" then return end
    if isSoldOutOrInvalid(code) then return end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end
    redeemQueue[#redeemQueue + 1] = code
    if redeemWorkerRunning then return end
    redeemWorkerRunning = true
    task.spawn(function()
        while #redeemQueue > 0 and os.clock() - lastSuccessfulRedeem >= REDEEM_LOCKOUT do
            local item = table.remove(redeemQueue, 1)
            if item then doRedeem(item); task.wait(1) end -- ⭐ 1 Second Delay for next secure answer
        end
        if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then redeemQueue = {} end
        redeemWorkerRunning = false
    end)
end
