local function SetSpeedVisual(on)
	if on then
		SpeedTrack.BackgroundColor3 = PURPLE_MAIN
		SpeedFill.BackgroundColor3 = PURPLE_BRIGHT
		SpeedFill:TweenSize(UDim2.new(1, 0, 1, 0), "Out", "Quad", 0.18, true)
		SpeedKnob:TweenPosition(UDim2.new(0, 31, 0.5, -12), "Out", "Back", 0.22, true)
		SpeedKnob.BackgroundColor3 = TEXT_WHITE
		SpeedKnobStroke.Color = PURPLE_BRIGHT

		SpeedKnob.Size = UDim2.new(0, 28, 0, 28)
		BubbleTween(SpeedKnob, {Size = UDim2.new(0, 24, 0, 24)}, 0.25)
	else
		SpeedTrack.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
		SpeedFill.BackgroundColor3 = PURPLE_MAIN
		SpeedFill:TweenSize(UDim2.new(0, 0, 1, 0), "Out", "Quad", 0.18, true)
		SpeedKnob:TweenPosition(UDim2.new(0, 3, 0.5, -12), "Out", "Back", 0.22, true)
		SpeedKnob.BackgroundColor3 = Color3.fromRGB(170, 170, 170)
		SpeedKnobStroke.Color = PURPLE_MAIN
	end
end

