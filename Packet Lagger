local function Save()
	pcall(function()
		writefile("packetlaggg.json", HttpService:JSONEncode({
			Tab = CurrentTab,
			GuiSize = GuiScale,
			Toggle = IsLagging,
			Keybind = Keybind and { Name = Keybind.Name, Type = KeybindType } or nil,
			SpeedEnabled = SpeedEnabled,
			SpeedStuds = SpeedStuds,
			SpeedInterval = SpeedInterval,
			CustomIntensity = CustomIntensity
		}))
	end)
end

local function Load()
	if not isfile("packetlaggg.json") then return end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile("packetlaggg.json"))
	end)
	if not ok or type(data) ~= "table" then return end

	if data.Tab == "PC" or data.Tab == "Mobile" or data.Tab == "Custom" then CurrentTab = data.Tab end
	if data.GuiSize then GuiScale = ClampScale(tonumber(data.GuiSize) or 0.7) end
	if data.Toggle ~= nil then IsLagging = data.Toggle end
	if data.Keybind and type(data.Keybind) == "table" and data.Keybind.Name then
		local kc = Enum.KeyCode[data.Keybind.Name]
		if kc then
			Keybind = kc
			KeybindType = data.Keybind.Type or "Keyboard"
		end
	end
	if data.SpeedEnabled ~= nil then SpeedEnabled = data.SpeedEnabled end
	if data.SpeedStuds then SpeedStuds = tonumber(data.SpeedStuds) or 15 end
	if data.SpeedInterval then SpeedInterval = tonumber(data.SpeedInterval) or 0.06 end
	if data.CustomIntensity then
		CustomIntensity = math.clamp(tonumber(data.CustomIntensity) or 75000, 1, 500000)
	end
end

Load()

-- Packet Lag
local NetRemote = nil
pcall(function()
	local net = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net")
	NetRemote = net:GetChildren()[230]
end)

local function GetIntensity()
	if CurrentTab == "PC" then return 50000 end
	if CurrentTab == "Mobile" then return 25000 end
	return CustomIntensity
end

local function FireLag(count)
	if not NetRemote then
		pcall(function()
			local net = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net")
			NetRemote = net:GetChildren()[230]
		end)
		if not NetRemote then return end
	end
	local payload = table.create(count, function() end)
	for _ = 1, 3 do
		pcall(function() NetRemote:FireServer(payload) end)
	end
end

local function LagLoop()
	while IsLagging do
		task.spawn(function() FireLag(GetIntensity()) end)
		task.wait(0.01)
	end
end

local function StartLag()
	if LagThread and coroutine.status(LagThread) ~= "dead" then return end
	IsLagging = true
	LagStartTime = os.clock()
	LagThread = coroutine.create(LagLoop)
	coroutine.resume(LagThread)
end

local function StopLag()
	IsLagging = false
	if LagThread then
		pcall(function() coroutine.close(LagThread) end)
		LagThread = nil
	end
end

