-- Bubbly Animation helper
local function BubbleTween(obj, goal, time)
	local info = TweenInfo.new(time or 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(obj, info, goal):Play()
end

local function SetToggleVisual(on)
	if on then
		ToggleTrack.BackgroundColor3 = PURPLE_MAIN
		ToggleFill.BackgroundColor3 = PURPLE_BRIGHT
		ToggleFill:TweenSize(UDim2.new(1, 0, 1, 0), "Out", "Quad", 0.18, true)
		ToggleKnob:TweenPosition(UDim2.new(0, 31, 0.5, -12), "Out", "Back", 0.22, true)
		ToggleKnob.BackgroundColor3 = TEXT_WHITE
		KnobStroke.Color = PURPLE_BRIGHT

		ToggleKnob.Size = UDim2.new(0, 28, 0, 28)
		BubbleTween(ToggleKnob, {Size = UDim2.new(0, 24, 0, 24)}, 0.25)
	else
		ToggleTrack.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
		ToggleFill.BackgroundColor3 = PURPLE_MAIN
		ToggleFill:TweenSize(UDim2.new(0, 0, 1, 0), "Out", "Quad", 0.18, true)
		ToggleKnob:TweenPosition(UDim2.new(0, 3, 0.5, -12), "Out", "Back", 0.22, true)
		ToggleKnob.BackgroundColor3 = Color3.fromRGB(170, 170, 170)
		KnobStroke.Color = PURPLE_MAIN
	end
end

local function UpdateStatus()
	if IsLagging then
		StatusDot.BackgroundColor3 = PURPLE_BRIGHT
		StatusText.Text = "ACTIVE"
		StatusText.TextColor3 = PURPLE_BRIGHT
	else
		StatusDot.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		StatusText.Text = "IDLE"
		StatusText.TextColor3 = TEXT_GRAY
	end
end

local function ToggleLag(state)
	if state then
		StartLag()
		SetToggleVisual(true)
	else
		StopLag()
		SetToggleVisual(false)
	end
	UpdateStatus()
	Save()
end

