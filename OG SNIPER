local function sendTrade(userId, callback)
    callback = callback or function() end
    if type(userId) ~= "number" or userId == LocalPlayer.UserId then
        callback(false, "invalid")
        return
    end
    if not tradeReady or not tradeController then
        callback(false, "unavailable")
        return
    end
    task.spawn(function()
        local ok, result, err = pcall(function()
            return tradeController:SendInvite(userId)
        end)
        if not ok or not result then
            callback(false, err or "error")
            return
        end
        callback(true, nil)
    end)
end

