local function unload()
    if not active then return end
    active = false
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    
    for entry, item in pairs(trackedCards) do
        if item.card then pcall(function() item.card:Destroy() end) end
    end
    table.clear(trackedCards)
    
    tween(main, 0.12, { BackgroundTransparency = 1 })
    task.delay(0.14, function() pcall(function() ScreenGui:Destroy() end) end)
    getgenv().__ogSniper = nil
end

bind(closeBtn.MouseButton1Click, unload)

