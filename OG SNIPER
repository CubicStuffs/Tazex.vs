local function randStr(len)
    len = len or 12
    local out = {}
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    for i = 1, len do
        local n = math.random(1, #chars)
        out[i] = chars:sub(n, n)
    end
    return table.concat(out)
end

local function create(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(inst, r)
    return create("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = inst })
end

local function stroke(inst, color, thickness)
    return create("UIStroke", {
        Color = color or COLORS.Stroke,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

local function gradient(inst, c1, c2, rot)
    return create("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 0,
        Parent = inst,
    })
end

local tweens = setmetatable({}, { __mode = "k" })
local function tween(inst, dur, props, style, dir)
    if tweens[inst] then pcall(function() tweens[inst]:Cancel() end) end
    local t = TweenService:Create(inst, TweenInfo.new(dur or 0.1, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tweens[inst] = t
    t:Play()
    return t
end

local connections = {}
local active = true
local function bind(sig, fn)
    local c = sig:Connect(function(...)
        if not active then return end
        local ok, err = pcall(fn, ...)
        if not ok then warn("[TAZEX] error:", err) end
    end)
    connections[#connections + 1] = c
    return c
end

local function buttonHover(btn, target, base, hover)
    bind(btn.MouseEnter, function() tween(target, 0.1, { BackgroundColor3 = hover }) end)
    bind(btn.MouseLeave, function() tween(target, 0.12, { BackgroundColor3 = base }) end)
end

local function buttonPress(btn, normalScale)
    normalScale = normalScale or 1
    local us = btn:FindFirstChildOfClass("UIScale") or create("UIScale", { Scale = normalScale, Parent = btn })
    bind(btn.MouseButton1Down, function() tween(us, 0.08, { Scale = normalScale - 0.05 }) end)
    bind(btn.MouseButton1Up, function() tween(us, 0.16, { Scale = normalScale }, Enum.EasingStyle.Back) end)
    return us
end

