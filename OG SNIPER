task.defer(function()
    local ok, err = pcall(loadOGSniper)
    if not ok then warn("[OG Sniper] launch error: " .. tostring(err)) end
end)

-- RightShift reopens the panel if it's been closed
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.RightShift then
        local ok, err = pcall(loadOGSniper)
        if not ok then warn("[OG Sniper] reopen error: " .. tostring(err)) end
    end
end)
