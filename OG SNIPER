do
    local resizing = false
    local rInput, rStart, rStartSize

    local grip = create("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, -19, 1, -19),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 6,
        Parent = main,
    })

    create("Frame", { Size = UDim2.fromOffset(10, 2), Position = UDim2.fromOffset(4, 8), BackgroundColor3 = COLORS.Accent2, BackgroundTransparency = 0.35, Rotation = 45, Parent = grip })
    create("Frame", { Size = UDim2.fromOffset(6, 2), Position = UDim2.fromOffset(8, 12), BackgroundColor3 = COLORS.Accent2, BackgroundTransparency = 0.35, Rotation = 45, Parent = grip })

    bind(grip.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            rInput = input
            rStart = input.Position
            rStartSize = main.AbsoluteSize
        end
    end)

    bind(UserInputService.InputChanged, function(input)
        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if rInput and rInput.UserInputType == Enum.UserInputType.Touch and input ~= rInput then return end
        local delta = input.Position - rStart
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
        local newW = math.clamp(math.floor(rStartSize.X + delta.X), 320, math.max(320, vp.X - 20))
        local newH = math.clamp(math.floor(rStartSize.Y + delta.Y), 280, math.max(280, vp.Y - 20))
        main.Size = UDim2.new(0, newW, 0, newH)
    end)

    bind(UserInputService.InputEnded, function(input)
        if input ~= rInput then return end
        resizing = false
        rInput = nil
        CONFIG.W = math.floor(main.AbsoluteSize.X)
        CONFIG.H = math.floor(main.AbsoluteSize.Y)
        saveConfig()
    end)
end

